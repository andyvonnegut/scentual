# Supabase — pull from the project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Optional direct Postgres URLs (for CLI tooling / migrations).
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
